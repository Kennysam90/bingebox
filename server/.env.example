# --- BingeBox API configuration ------------------------------------------
# Copy to server/.env and adjust. Every value is optional in development.

# PORT=8787
# Animedoc Live Movie API. Keep this server-side; never use a VITE_ variable.
# ANIMEDOC_API_KEY=ad_live_your_key
# Password recovery email (Resend API key and a verified sender).
# RESEND_API_KEY=re_your_key
# EMAIL_FROM=BingeBox <hello@your-domain.com>
# Public URL of the web app (used in password-reset links).
# APP_URL=http://localhost:5173

# First admin account, created on first boot. REQUIRED in production.
# ADMIN_EMAIL=admin@bingebox.local
# ADMIN_PASSWORD=change-me-to-something-long

# Storage locations (mount a volume here in production).
# DATABASE_FILE=data/bingebox.db
# UPLOADS_DIR=data/uploads

# Streaming hosts admins may add video URLs from (comma-separated, *.wildcards ok).
# AUTHORISED_VIDEO_HOSTS=cdn.your-licensed-provider.com

# Behind a reverse proxy / load balancer:
# TRUST_PROXY=true
# Separately hosted frontend origins allowed to call the API with cookies:
# ALLOWED_ORIGINS=https://bingebox.example.com
# SESSION_DAYS=30
