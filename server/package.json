{
  "name": "bingebox-server",
  "private": true,
  "version": "1.0.0",
  "type": "module",
  "description": "BingeBox API: catalog, accounts, playback progress and admin.",
  "scripts": {
    "test": "tsx --test test/*.test.ts",
    "dev": "tsx watch --clear-screen=false src/index.ts",
    "build": "tsc -p tsconfig.json",
    "start": "NODE_ENV=production node dist/index.js",
    "typecheck": "tsc --noEmit -p tsconfig.json && tsc --noEmit -p tsconfig.scripts.json",
    "db:reset": "rm -f data/bingebox.db data/bingebox.db-wal data/bingebox.db-shm && echo 'Database removed; the catalog will be loaded from AnimeDoc on next start.'"
  },
  "engines": {
    "node": ">=20.12"
  },
  "dependencies": {
    "better-sqlite3": "^11.10.0",
    "compression": "^1.8.2",
    "cookie-parser": "^1.4.7",
    "express": "^4.22.3",
    "express-rate-limit": "^7.5.1",
    "helmet": "^8.3.0",
    "multer": "^2.5.0",
    "zod": "^3.25.76"
  },
  "devDependencies": {
    "@types/better-sqlite3": "^9.6.0",
    "@types/compression": "^1.8.1",
    "@types/cookie-parser": "^1.4.10",
    "@types/express": "^4.17.25",
    "@types/multer": "^2.3.0",
    "@types/node": "^22.20.4",
    "tsx": "^4.23.15",
    "typescript": "^5.9.3"
  }
}
